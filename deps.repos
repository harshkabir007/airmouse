# Third-party ROS 2 packages, built into /opt/airmouse_deps by scripts/build_deps.sh.
# After the first successful build, pin exact commits for reproducibility:
#   vcs export --exact /opt/airmouse_deps/src > deps.repos
repositories:
  livox_ros_driver2:
    type: git
    url: https://github.com/Livox-SDK/livox_ros_driver2.git
    version: master
  FAST_LIO:
    type: git
    url: https://github.com/hku-mars/FAST_LIO.git
    version: ROS2
