{
  "name": "AirMouse (simulation)",
  "dockerComposeFile": ["../compose.yaml"],
  "service": "sim",
  "workspaceFolder": "/airmouse",
  "shutdownAction": "stopCompose",
  "postCreateCommand": "bash /airmouse/scripts/build_ws.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-iot.vscode-ros",
        "redhat.vscode-yaml"
      ]
    }
  }
}
